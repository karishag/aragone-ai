# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=image_validator
DB_USER=postgres
DB_PASSWORD=your_password_here

# AWS S3 (or compatible service like Cloudflare R2, MinIO, Supabase Storage)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Alternative: Use Cloudflare R2 (S3-compatible, generous free tier)
# Set AWS_ENDPOINT_URL to your R2 endpoint if using R2:
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Cloudinary (alternative to S3 - very easy free tier setup)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=10

# Validation thresholds
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200
MIN_FILE_SIZE_BYTES=10240
BLUR_THRESHOLD=100
SIMILARITY_THRESHOLD=0.85
MIN_FACE_RATIO=0.05
